# Supabase (required for real accounts, persistence, and public /[username] pages)
# Create a free project at https://supabase.com, then Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of this deployment, used for OG images and canonical links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
